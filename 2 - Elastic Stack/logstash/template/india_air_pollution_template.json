{
    "index_patterns": "india_index_patterns",
    "settings": {
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "doc": {
        "dynamic_templates": [
          {
            "string_fields": {
              "mapping": {
                "type": "text",
                "omit_norms": true,
                "fields": {
                  "keyword": {
                    "type": "keyword",
                    "ignore_above": 256
                  }
                }
              },
              "match_mapping_type": "string",
              "match": "*"
            }
          }
        ],
        "properties": {
          "@version": {
            "type": "keyword"
          },
          "timestamp_filter": {
            "type": "date", 
            "format": "yyyy-MM-dd", 
            "ignore_malformed": true
        },
          "pm25": {
            "type": "float",
            "ignore_malformed": true
          },
          "pm10": {
            "type": "float",
            "ignore_malformed": true
          },
          "no2": {
            "type": "float",
            "ignore_malformed": true
          },
          "nox": {
            "type": "float",
            "ignore_malformed": true
          },
          "nh3": {
            "type": "float",
            "ignore_malformed": true
          },
          "co": {
            "type": "float",
            "ignore_malformed": true
          },
          "so2": {
            "type": "float",
            "ignore_malformed": true
          },
          "o3": {
            "type": "float",
            "ignore_malformed": true
          },
          "benzene": {
            "type": "float",
            "ignore_malformed": true
          },
          "toluene": {
            "type": "float",
            "ignore_malformed": true
          },
          "xylene": {
            "type": "float",
            "ignore_malformed": true
          },
          "aqi": {
            "type": "float",
            "ignore_malformed": true
          },
          "aqi_bucket": {
            "type": "keyword"
          }
        }
      }
    },
    "aliases": {}
  }
  