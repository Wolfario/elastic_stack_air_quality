{
    "index_patterns": "seoul_index_patterns",
    "settings": {
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "doc": {
        "dynamic_templates": [
          {
            "string_fields": {
              "mapping": {
                "type": "text",
                "omit_norms": true,
                "fields": {
                  "keyword": {
                    "type": "keyword",
                    "ignore_above": 256
                  }
                }
              },
              "match_mapping_type": "string",
              "match": "*"
            }
          }
        ],
        "properties": {
          "@version": {
            "type": "keyword"
          },
          "timestamp_filter": {
            "type": "date", 
            "format": "yyyy-MM-dd HH:mm", 
            "ignore_malformed": true
        },
          "station_code": {
            "type": "integer",
            "ignore_malformed": true
          },
          "address": {
            "type": "keyword"
          },
          "location": {
            "type": "geo_point",
            "ignore_malformed": true
          },
          "so2": {
            "type": "float",
            "ignore_malformed": true
          },
          "no2": {
            "type": "float",
            "ignore_malformed": true
          },
          "o3": {
            "type": "float",
            "ignore_malformed": true
          },
          "co": {
            "type": "float",
            "ignore_malformed": true
          },
          "pm10": {
            "type": "float",
            "ignore_malformed": true
          },
          "pm25": {
            "type": "float",
            "ignore_malformed": true
          },
          "latitude": {
            "type": "float",
            "ignore_malformed": true
          },
          "longitude": {
            "type": "float",
            "ignore_malformed": true
          }
        }
      }
    },
    "aliases": {}
  }
  