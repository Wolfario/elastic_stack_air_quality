{
    "index_patterns": "mexico_index_patterns",
    "settings": {
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "doc": {
        "dynamic_templates": [
          {
            "string_fields": {
              "mapping": {
                "type": "text",
                "omit_norms": true,
                "fields": {
                  "keyword": {
                    "type": "keyword",
                    "ignore_above": 256
                  }
                }
              },
              "match_mapping_type": "string",
              "match": "*"
            }
          }
        ],
        "properties": {
          "@version": {
            "type": "keyword"
          },
          "timestamp_filter": {
            "type": "date", 
            "format": "yyyy-MM-dd", 
            "ignore_malformed": true
          },
